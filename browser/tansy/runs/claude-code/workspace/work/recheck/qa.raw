"{\n \"banner\": \"Made-up data room for testing agents. Every company, person and figure here is fictional.\",\n \"statuses\": [\n  \"Answered\",\n  \"Open\",\n  \"Awaiting documents\"\n ],\n \"topics\": [\n  \"Financial\",\n  \"Commercial\",\n  \"People\",\n  \"Property\",\n  \"Legal\",\n  \"Operations\"\n ],\n \"entries\": [\n  {\n   \"id\": \"Q-01\",\n   \"topic\": \"Financial\",\n   \"status\": \"Answered\",\n   \"asked\": \"2026-10-05\",\n   \"answered\": \"2026-10-07\",\n   \"question\": \"Why do management and audited FY2026 revenue differ?\",\n   \"answer\": \"The installation cut-off adjustment is £290k. See 2.6 for the full reconciliation.\",\n   \"refs\": [\n    \"2.6\",\n    \"2.2\",\n    \"2.3\"\n   ]\n  },\n  {\n   \"id\": \"Q-02\",\n   \"topic\": \"Commercial\",\n   \"status\": \"Answered\",\n   \"asked\": \"2026-10-06\",\n   \"answered\": \"2026-10-09\",\n   \"question\": \"Has Wendmoor renewed?\",\n   \"answer\": \"Renewal discussions are continuing for the term ending 31 March 2027. No renewal has been signed.\",\n   \"refs\": [\n    \"3.2\"\n   ]\n  },\n  {\n   \"id\": \"Q-03\",\n   \"topic\": \"Property\",\n   \"status\": \"Answered\",\n   \"asked\": \"2026-10-08\",\n   \"answered\": \"2026-10-12\",\n   \"question\": \"Is there a break in the Nottingham lease?\",\n   \"answer\": \"The tenant break is 30 September 2028 with six months’ notice. No notice has been served.\",\n   \"refs\": [\n    \"5.1\"\n   ]\n  },\n  {\n   \"id\": \"Q-04\",\n   \"topic\": \"Legal\",\n   \"status\": \"Answered\",\n   \"asked\": \"2026-10-13\",\n   \"answered\": \"2026-10-15\",\n   \"question\": \"Has Ardnacree issued proceedings?\",\n   \"answer\": \"No proceedings have been issued. The company disputes liability and is reviewing technical evidence.\",\n   \"refs\": [\n    \"6.1\",\n    \"6.2\"\n   ]\n  },\n  {\n   \"id\": \"Q-05\",\n   \"topic\": \"People\",\n   \"status\": \"Answered\",\n   \"asked\": \"2026-10-21\",\n   \"answered\": \"2026-10-23\",\n   \"question\": \"Does the census include Kilcarrow fixed-term staff?\",\n   \"answer\": \"Version 2 includes employed fixed-term staff within Kilcarrow. Agency workers are excluded.\",\n   \"refs\": [\n    \"4.1\"\n   ]\n  },\n  {\n   \"id\": \"Q-06\",\n   \"topic\": \"Commercial\",\n   \"status\": \"Answered\",\n   \"asked\": \"2026-10-16\",\n   \"answered\": \"2026-10-19\",\n   \"question\": \"Why is Dunstreath absent from the top-customer schedule?\",\n   \"answer\": \"Dunstreath Retail Group plc left for a national facilities-management provider. The contract ended on 31 March 2026; FY2026 revenue was £3,420k on the management accounts basis. No other customer that has stopped trading with the group since 1 April 2025 had FY2026 revenue above £250k, counting all group companies, contracts and project work.\",\n   \"refs\": [\n    \"3.1\",\n    \"1.2\"\n   ]\n  },\n  {\n   \"id\": \"Q-07\",\n   \"topic\": \"Financial\",\n   \"status\": \"Answered\",\n   \"asked\": \"2026-10-29\",\n   \"answered\": \"2026-11-02\",\n   \"question\": \"Why does the certificate show 3.25:1 when 2.7 says 3.00:1?\",\n   \"answer\": \"The executed amendment letter of 12 August 2026 (2.11) set the maximum at 3.25:1 for test dates from 30 September 2026 to 31 March 2027, returning to 3.00:1 from 30 June 2027. Document 2.7 predates it and will be revised.\",\n   \"refs\": [\n    \"2.7\",\n    \"2.8\",\n    \"2.11\"\n   ]\n  },\n  {\n   \"id\": \"Q-08\",\n   \"topic\": \"Operations\",\n   \"status\": \"Answered\",\n   \"asked\": \"2026-10-22\",\n   \"answered\": \"2026-10-26\",\n   \"question\": \"When is the monitoring platform migration planned?\",\n   \"answer\": \"January 2027, following dual running and acceptance tests. The timetable remains subject to operational sign-off.\",\n   \"refs\": [\n    \"3.7\"\n   ]\n  },\n  {\n   \"id\": \"Q-09\",\n   \"topic\": \"Legal\",\n   \"status\": \"Awaiting documents\",\n   \"asked\": \"2026-10-27\",\n   \"answered\": null,\n   \"question\": \"Please provide the Kilcarrow SPA and deferred and contingent consideration outstanding.\",\n   \"answer\": \"The SPA will be made available and the contingent consideration redaction in 2.2 lifted in a later phase, once the Kilcarrow vendors’ consent to disclosure is in place.\",\n   \"refs\": [\n    \"2.2\"\n   ]\n  },\n  {\n   \"id\": \"Q-10\",\n   \"topic\": \"Financial\",\n   \"status\": \"Answered\",\n   \"asked\": \"2026-10-14\",\n   \"answered\": \"2026-10-16\",\n   \"question\": \"Is the FY2027 budget board-approved?\",\n   \"answer\": \"Yes, the board approved it on 26 March 2026; see the minutes extract at 1.3.\",\n   \"refs\": [\n    \"1.3\",\n    \"2.9\"\n   ]\n  },\n  {\n   \"id\": \"Q-11\",\n   \"topic\": \"Operations\",\n   \"status\": \"Open\",\n   \"asked\": \"2026-11-03\",\n   \"answered\": null,\n   \"question\": \"Please provide the detailed engineering capacity plan for FY2027.\",\n   \"answer\": null,\n   \"refs\": [\n    \"2.9\"\n   ]\n  },\n  {\n   \"id\": \"Q-12\",\n   \"topic\": \"People\",\n   \"status\": \"Answered\",\n   \"asked\": \"2026-10-20\",\n   \"answered\": \"2026-10-22\",\n   \"question\": \"Is census v2 complete?\",\n   \"answer\": \"Census v1 left out Kilcarrow. Version 2 of 19 October 2026 is complete. Please use v2.\",\n   \"refs\": [\n    \"4.1\"\n   ]\n  }\n ]\n}"
